{
   "mcpServers": {
      "sonarqube": {
         "type": "http",
         "url": "https://api.sonarcloud.io/mcp",
         "headersHelper": "bash scripts/sonarqube-mcp-headers.sh",
         "headers": {
            "Authorization": "Bearer ${SONARQUBE_TOKEN}",
            "SONARQUBE_ORG": "aabmets",
            "SONARQUBE_READ_ONLY": "true"
         }
      }
   }
}
