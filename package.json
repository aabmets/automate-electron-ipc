{
   "name": "automate-electron-ipc",
   "version": "1.0.0",
   "description": "Node library for automating the generation of IPC components for Electron apps.",
   "keywords": [
      "electron",
      "ipc",
      "autoipc",
      "ipcgen",
      "automation",
      "generator",
      "ipc-generator",
      "ipc-automation",
      "electron-ipc",
      "electron-automation"
   ],
   "type": "module",
   "license": "Apache-2.0",
   "homepage": "https://aabmets.github.io/automate-electron-ipc/",
   "repository": {
      "type": "git",
      "url": "https://github.com/aabmets/automate-electron-ipc.git"
   },
   "author": "Mattias Aabmets <mattias.aabmets@gmail.com>",
   "files": [
      "dist",
      "types",
      "README.md",
      "LICENSE"
   ],
   "types": "./types/index.d.ts",
   "module": "./dist/index.js",
   "exports": {
      ".": {
         "types": "./types/index.d.ts",
         "default": "./dist/index.js"
      },
      "./api": {
         "types": "./types/api.d.ts",
         "default": "./dist/api.js"
      },
      "./vite": {
         "types": "./types/vite.d.ts",
         "default": "./dist/vite.js"
      }
   },
   "bin": {
      "ipcgen": "./dist/cli.js"
   },
   "scripts": {
      "check": "tsc -p tsconfig.json --noEmit && biome check && bun scripts/check-size.ts",
      "test:electron": "vitest run tests/test_electron --coverage.enabled=false",
      "pubtest": "tsc -p tsconfig.json && bun pm pack --destination ./packages",
      "pubnow": "biome check --error-on-warnings && tsc -p tsconfig.json && bun publish"
   },
   "dependencies": {
      "@swc/core": "1.16.13",
      "commander": "15.0.0",
      "superstruct": "2.0.2"
   },
   "devDependencies": {
      "@biomejs/biome": "2.5.15",
      "@types/bun": "1.4.2",
      "@types/node": "22.20.5",
      "@types/react": "19.3.0",
      "@vitest/coverage-v8": "5.0.3",
      "electron": "44.7.0",
      "lefthook": "2.2.0",
      "react": "19.3.0",
      "typescript": "7.0.2",
      "vitest": "5.0.3",
      "vue": "3.5.43"
   },
   "peerDependencies": {
      "electron": ">=30.0.0"
   },
   "peerDependenciesMeta": {
      "electron": {
         "optional": true
      }
   },
   "engines": {
      "node": ">=22.13.0"
   },
   "config": {
      "autoipc": {
         "ipcDataDir": "./.exclude/autoipc"
      }
   }
}
